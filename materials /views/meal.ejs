<!DOCTYPE html>
<html lang="en">
  <!-- head -->
  <%- include('partials/head') %>

  <body >
    <div class="container">
      <!-- Your header here -->
      <%- include('partials/header', { meal }) %> 

      <!-- Main content -->
      <main >

        <div  >
          <img src="<%= meal.imageUrl %>" height="450" alt="mealImg" class="w-100" />
          <section class="mt-3">
            <h1><strong><%= meal.name %></strong></h1>
            <span> <%= meal.timeOfDay %> - <%= meal.mealType %> </span>
          </section>
        </div>

        <!-- Back button here -->
        <div class="text-center">
          <a href="/">
            <button type="submit" id="btn-back" class="btn btn-primary px-4 ">Back</button>
          </a>
        </div>
      </main>

    </div>

    <div class="mt-5">
      <%- include('partials/foot') %>
    </div>

  </body>
</html>
