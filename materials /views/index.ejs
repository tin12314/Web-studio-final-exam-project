<!DOCTYPE html>
<html lang="en">
  <!-- head -->
  <%- include('partials/head') %>

  <body>
    <div class="container">
      <!-- Your header here -->
      <%- include('partials/header') %>

      <!-- Main content -->
      <main class="d-flex flex-column flex-lg-row gap-5">
        <!-- Your profile here -->
        <aside id="profile" class="p-3 mb-2 bg-primary text-white d-flex flex-column align-items-center text-center text-lg-start gap-3">
          <div>
            <img
              src="images/profile.png"
              alt="tin"
              height="250"
              class="rounded-circle"
            />
          </div>
          <div>
            <div>
              <span>Hi, I'm</span>
               <h1>Do Thanh Tin</h1>
            </div>
            <div class="fst-italic">
              <p>s3970879</p>
              <p>s3970879@rmit.edu.vn</p>
            </div>
          </div>
        </aside>

        <!-- Your meal plan here -->
        <section id="meal-plan" class="w-100">
          <div class="text-lg-end text-center mb-5 mt-3">
            <h1><%= plan.name %></h1>
            <form action="/" method="post">
              <button class="btn btn-primary px-4">Refresh</button>
            </form>

          </div>

          <!-- Your meal list here -->
          <div id="meal-list">
            <!-- first -->
            <div class="row">
              <div class="col">
                <a href="/meal/<%= plan.meals[0].name %>">
                  <img
                    src="<%= plan.meals[0].imageUrl %>"
                    height="300"
                    alt="mealImg"
                    class="w-100 mb-2"
                  />
                  <section>
                    <h3><%= plan.meals[0].name %></h3>
                    <span> <%= plan.meals[0].timeOfDay %>- <%= plan.meals[0].mealType%> </span>
                  </section>
                </a>
              </div>
            </div>
            <!-- second -->
            <div class="row mt-4">
              <div class="col">
                <a href="/meal/<%= plan.meals[1].name %>">
                  <img
                    src="<%= plan.meals[1].imageUrl %>"
                    height="150"
                    alt="mealImg"
                    class="w-100"
                    
                  />
                  <section>
                    <h3><%= plan.meals[1].name %></h3>
                    <span>  <%= plan.meals[1].timeOfDay %>-<%= plan.meals[1].mealType%> </span>
                  </section>
                </a>
              </div>
              <!-- third -->
              <div class="col">
                <a href="/meal/<%= plan.meals[2].name %>">
                  <img
                    src="<%= plan.meals[2].imageUrl %>"
                    height="150"
                    alt="mealImg"
                    class="w-100"
                  />
                  <section>
                    <h3>M<%= plan.meals[2].name %></h3>
                    <span> <%= plan.meals[2].timeOfDay %>-<%= plan.meals[2].mealType%> </span>
                  </section>
                </a>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <%- include('partials/foot') %>
    <script src="/scripts/index.js"></script>
  </body>
</html>
